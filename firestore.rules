rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Properties are publicly readable, authenticated or admin writable
    match /properties/{propertyId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Appointments can be read/written by users and admins
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }
    
    // Inquiries can be submitted by visitors
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }
    
    // Site configuration
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // User profiles & favorites
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
